<UserControl x:Class="GSCLab.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#070707">

    <UserControl.Resources>
        <Style x:Key="ModernScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#007ACC" CornerRadius="3" Width="6" Margin="2,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#1C1C1C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
        </Style>

        <Style x:Key="SectionHeaderTxt" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="GameCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#1C1C1C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                    <Setter Property="Background" Value="#151515"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30">

            <TextBlock Name="DASHOVERVIEW" Text="DASHBOARD OVERVIEW" Foreground="#007ACC" FontSize="20" FontWeight="Black" Margin="0,0,0,25"/>

            <UniformGrid Columns="4" Margin="0,0,-15,15">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="USERS ONLINE" Foreground="#666" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding OnlineUsersCount}" FontSize="36" FontWeight="Black" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="REGISTERED USERS" Foreground="#666" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding RegisteredUsersCount}" FontSize="36" FontWeight="Black" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="INJECTIONS MADE" Foreground="#666" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding TotalInjections}" FontSize="36" FontWeight="Black" Foreground="White"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="TOOL VERSION" Foreground="#666" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="Tester 0.0.6" FontSize="30" FontWeight="Black" Foreground="#28A745" VerticalAlignment="Bottom" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="SUPPORTED TITLES" Style="{StaticResource SectionHeaderTxt}" Margin="0,15,0,15"/>
            <ItemsControl ItemsSource="{Binding SupportedGames}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,20,25">
                            <Border Width="120" Height="160" Style="{StaticResource GameCardStyle}">
                                <Grid>
                                    <Border x:Name="Mask" Background="Black" CornerRadius="11"/>
                                    <Image Source="{Binding ImagePath}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.OpacityMask>
                                            <VisualBrush Visual="{Binding ElementName=Mask}"/>
                                        </Image.OpacityMask>
                                    </Image>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding GameName}" Foreground="White" FontWeight="Bold" FontSize="11" Margin="0,10,0,2" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Platforms}" Foreground="#007ACC" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="LATEST ANNOUNCEMENTS" Style="{StaticResource SectionHeaderTxt}"/>
            <Border Background="#111111" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="12" Padding="30" Margin="0,0,0,30">
                <StackPanel>
                    <TextBlock Text="{Binding LatestAnnouncement.Title}" Foreground="White" FontSize="18" FontWeight="Black"/>
                    <Border Height="1" Background="#222" Margin="0,10,0,15"/>
                    <TextBlock Text="{Binding LatestAnnouncement.Content}" Foreground="#AAA" TextWrapping="Wrap" FontSize="13" LineHeight="22"/>
                </StackPanel>
            </Border>

            <TextBlock Text="UPDATE LOG" Style="{StaticResource SectionHeaderTxt}"/>
            <Border Background="#111111" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="12" Padding="30" Margin="0,0,0,30">
                <TextBlock Text="{Binding LatestAnnouncement.Changelog}" Foreground="#888" FontSize="12" LineHeight="22" TextWrapping="Wrap" FontFamily="Consolas"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>