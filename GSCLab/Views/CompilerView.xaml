<UserControl x:Class="GSCLab.Views.CompilerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:GSCLab.Infrastructure"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:Search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit"
             xmlns:views="clr-namespace:GSCLab.Views"
             xmlns:folding="clr-namespace:ICSharpCode.AvalonEdit.Folding;assembly=ICSharpCode.AvalonEdit"
             Background="#0A0A0A">
    
    

    <UserControl.Resources>
        <Style TargetType="{x:Type folding:FoldingMargin}">
            <Setter Property="FoldingMarkerBrush" Value="#333333"/>
            <Setter Property="SelectedFoldingMarkerBrush" Value="#007ACC"/>
        </Style>

        <Style TargetType="{x:Type Control}" x:Key="FoldingMarkerStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Border Width="12" Height="12" 
                        Background="#1E1E1E" 
                        BorderBrush="#444444" 
                        BorderThickness="1" 
                        CornerRadius="2">
                            <Path Data="M 2,6 H 10" Stroke="#D4D4D4" StrokeThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchButtonStyle" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4" 
                        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A007ACC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#33007ACC"/>
                                <Setter Property="Foreground" Value="#007ACC"/>
                            </Trigger>

                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A007ACC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#44007ACC"/>
                                <Setter Property="Foreground" Value="#007ACC"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Search:SearchPanel}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Search:SearchPanel}">
                        <Border Background="#121212" 
                        BorderBrush="#1A1A1A" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Margin="0,10,25,0" 
                        Padding="8" 
                        Panel.ZIndex="100">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Color="Black" Opacity="0.5"/>
                            </Border.Effect>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="ReplaceToggle" Content="˃" Style="{StaticResource SearchButtonStyle}" Width="20" Height="26" Margin="0,0,6,0" FontSize="12" FontWeight="Bold"/>

                                    <Border Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1" CornerRadius="4">
                                        <TextBox x:Name="PART_searchTextBox" PreviewDragEnter="SearchBox_PreviewDrag" PreviewDragOver="SearchBox_PreviewDrag" AllowDrop="False" Width="200" Height="26" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0" CaretBrush="#007ACC" Tag="Find" TextChanged="SearchInput_TextChanged"/>
                                    </Border>

                                    <Button Click="FindPrev_Click" Content="▲" Style="{StaticResource SearchButtonStyle}" Margin="6,0,0,0" Width="26" Height="26"/>

                                    <Button Click="FindNext_Click" Content="▼" Style="{StaticResource SearchButtonStyle}" Width="26" Height="26"/>

                                    <Button x:Name="PART_closeButton" Click="CloseSearch_Click" Content="✕" Style="{StaticResource SearchButtonStyle}" Margin="6,0,0,0" Width="26" Height="26"/>
                                </StackPanel>

                                <StackPanel x:Name="ReplaceRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Border Width="26"/>

                                    <Border Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="1" CornerRadius="4">
                                        <TextBox x:Name="ReplaceInput" PreviewDragEnter="SearchBox_PreviewDrag" PreviewDragOver="SearchBox_PreviewDrag" AllowDrop="False" Width="200" Height="26" Background="Transparent" Foreground="#AAA" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0" CaretBrush="#007ACC" Tag="Replace"/>
                                    </Border>

                                    <Button Click="ReplaceNext_Click" Content="REP" Style="{StaticResource SearchButtonStyle}" Margin="6,0,0,0" Width="36" Height="26" FontSize="9" FontWeight="Bold"/>

                                    <Button Click="ReplaceAll_Click" Content="ALL" Style="{StaticResource SearchButtonStyle}" Width="36" Height="26" FontSize="9" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger SourceName="ReplaceToggle" Property="IsChecked" Value="True">
                                <Setter TargetName="ReplaceRow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ReplaceToggle" Property="Content" Value="˅"/>
                                <Setter TargetName="ReplaceToggle" Property="Foreground" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#121212"/>
            <Setter Property="BorderBrush" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Margin="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconContainer" Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="5,0,20,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{ComponentResourceKey ResourceId=ScrollViewerCornerStyle, TypeInTargetAssembly={x:Type ScrollViewer}}" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Control}">
                        <Border Background="#0F0F0F" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0" AutomationProperties.AutomationId="VerticalScrollBar" Cursor="Arrow" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportHeight}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1" Orientation="Horizontal" AutomationProperties.AutomationId="HorizontalScrollBar" Cursor="Arrow" Maximum="{TemplateBinding ScrollableWidth}" Minimum="0" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportWidth}"/>
                            <Border Grid.Column="1" Grid.Row="1" Background="#0F0F0F"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#333" CornerRadius="4" Margin="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="10"/>
                                <Setter TargetName="Bg" Property="Margin" Value="0,0,0,0"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="10"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="false"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <infra:IndentConverter x:Key="IndentConverter" IndentMultiplier="15"/>

        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border x:Name="Selection_Border" Background="{TemplateBinding Background}" MinHeight="22" SnapsToDevicePixels="True" IsHitTestVisible="True">
                                <Grid Background="Transparent" Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IndentConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Visibility="Collapsed" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="16" Height="16">
                                                    <Path x:Name="Arrow" Data="M 1 1 L 4.5 4.5 L 1 8" Stroke="#555" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="Data" Value="M 1 1 L 4.5 4.5 L 8 1"/>
                                                        <Setter TargetName="Arrow" Property="Stroke" Value="#007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header" Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selection_Border" Property="Background" Value="#37373D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" SourceName="Selection_Border" Value="True">
                                <Setter TargetName="Selection_Border" Property="Background" Value="#2A2D2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SleekExpander" TargetType="Expander">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="ContentRow" Height="0"/>
                            </Grid.RowDefinitions>
                            <Border Background="#161616" BorderBrush="#222" BorderThickness="0,0,0,1" Padding="10,8">
                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0" Stroke="#007ACC" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="-90"/>
                                            </Path.RenderTransform>
                                        </Path>
                                        <ContentPresenter ContentSource="Header" TextElement.Foreground="#007ACC" />
                                    </StackPanel>
                                </ToggleButton>
                            </Border>
                            <Border Grid.Row="1" x:Name="ExpandSite" Background="#121212" Visibility="Collapsed">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentRow" Property="Height" Value="Auto"/>
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BBB"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" x:Name="border">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <EventSetter Event="PreviewMouseDown" Handler="TabItem_PreviewMouseDown"/>
            <EventSetter Event="PreviewMouseMove" Handler="TabItem_PreviewMouseMove"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="#121212" BorderBrush="#1A1A1A" BorderThickness="1,1,1,0" Margin="0,0,1,0">
                            <StackPanel Orientation="Horizontal" Margin="12,6">
                                <TextBlock Text="{TemplateBinding Header}" x:Name="TabText" Foreground="#777" FontSize="11"/>
                                <TextBlock x:Name="CloseBtn" Text="×" Foreground="#444" Margin="10,0,0,0" Cursor="Hand" VerticalAlignment="Center" PreviewMouseLeftButtonDown="CloseTab_Click"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0F0F0F"/>
                                <Setter TargetName="TabText" Property="Foreground" Value="#007ACC"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="I" Modifiers="Control"
                    Command="{Binding CtrlICommand}" />

        <KeyBinding Key="S" Modifiers="Control"
                    Command="{Binding CtrlSCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="180"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#121212" BorderBrush="#1A1A1A" BorderThickness="0,0,1,0">
            <DockPanel>
                <Expander Header="PROJECT OPTIONS" IsExpanded="True" DockPanel.Dock="Top" Style="{StaticResource SleekExpander}" FontWeight="Black" FontSize="10">
                    <StackPanel Background="#121212" Margin="0,5">
                        <Button Content="➕ New Project" Style="{StaticResource SidebarActionBtn}" Name="NewProjectButton" Click="NewProjectButton_Click"/>
                        <Button Content="📁 Open Project" Style="{StaticResource SidebarActionBtn}" Name="OpenProjectButton" Click="OpenProjectButton_Click"/>
                        <Button Content="💾 Save Project" Style="{StaticResource SidebarActionBtn}" Name="SaveButton" Click="SaveButton_Click"/>
                        <Button Content="❌ Close Project" Style="{StaticResource SidebarActionBtn}" Name="CloseButton" Click="CloseButton_Click"/>
                        <Separator Background="#222" Height="1" Margin="10,5"/>
                        <Button Content="✔️ Check Syntax" Style="{StaticResource SidebarActionBtn}" Name="btnCheckSyntax" Click="btnCheckSyntax_Click"/>
                        <Button Content="⚡ Inject" Style="{StaticResource SidebarActionBtn}" FontWeight="Bold" Name="InjectButton" Click="InjectButton_Click"/>
                        <Button Content="🔧 Editor Preferences" Style="{StaticResource SidebarActionBtn}" FontWeight="Bold" Name="EditorSettingsButton" Click="EditorSettingsButton_Click"/>
                    </StackPanel>
                </Expander>
                <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="12,12">
                    <TextBlock Text="SOLUTION EXPLORER" Foreground="#666" FontSize="10" FontWeight="Bold"/>
                </Border>
                <TreeView x:Name="SolutionTreeView" Background="Transparent" BorderThickness="0" Foreground="#CCC" Margin="0" Padding="0" HorizontalContentAlignment="Stretch" MouseDoubleClick="SolutionTreeView_MouseDoubleClick" ContextMenuOpening="SolutionTreeView_ContextMenuOpening" AllowDrop="True" PreviewMouseLeftButtonDown="SolutionTreeView_PreviewMouseLeftButtonDown" PreviewMouseMove="SolutionTreeView_PreviewMouseMove" PreviewMouseLeftButtonUp="SolutionTreeView_PreviewMouseLeftButtonUp" DragOver="SolutionTreeView_DragOver" Drop="SolutionTreeView_Drop">

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnPreviewMouseRightButtonDown" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="SolutionContext">
                            <MenuItem x:Name="MenuAddGsc" Header="Add New GSC File" Click="AddGscFile_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📄" Foreground="#007ACC" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="MenuAddFolder" Header="Add New Folder" Click="AddFolder_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="📁" Foreground="#007ACC" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator x:Name="MenuSeparator" Background="#222" Margin="5,2"/>
                            <MenuItem Header="Rename" Click="RenameItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="✏️" Foreground="#888" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Delete" Click="DeleteItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="🗑️" Foreground="#888" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#1A1A1A"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="OutputRow" Height="180"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" AllowDrop="True" Drop="MainEditorGrid_Drop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" x:Name="LeftEditorColumn"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0" x:Name="RightEditorColumn"/>
                </Grid.ColumnDefinitions>

                <TabControl x:Name="EditorTabs" SelectionChanged="EditorTabs_SelectionChanged" Grid.Column="0" Background="#0F0F0F" BorderThickness="0">
                    <TabItem Header="Examples" Name="tabExamples">
                        <Grid Background="#0F0F0F">
                            <avalonEdit:TextEditor x:Name="GscEditor" Background="#0F0F0F" Foreground="#D4D4D4" FontFamily="Consolas" FontSize="13" ShowLineNumbers="True" LineNumbersForeground="#555555" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="10" PreviewKeyDown="GscEditor_PreviewKeyDown" IsReadOnly="True" />
                        </Grid>
                    </TabItem>
                </TabControl>

                <GridSplitter x:Name="EditorSplitter" Grid.Column="1" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#1A1A1A" Visibility="Collapsed" Cursor="SizeWE"/>

                <TabControl x:Name="EditorTabsRight" Grid.Column="2" Background="#0F0F0F" BorderThickness="0" Visibility="Collapsed"/>

                <Button Grid.ColumnSpan="3" Content="🐞 Debug Console" Click="ToggleOutput_Click" Style="{StaticResource SidebarActionBtn}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,25,15" Padding="12,8" Panel.ZIndex="99"/>
            </Grid>

            <GridSplitter Grid.Row="1" Height="2" HorizontalAlignment="Stretch" Background="#1A1A1A"/>

            <Border x:Name="OutputBorder" Grid.Row="2" Background="#0A0A0A" BorderBrush="#007ACC" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#111" Height="28">
                        <DockPanel>
                            <TextBlock Text="DEBUG CONSOLE" Foreground="#007ACC" FontSize="9" FontWeight="Black" Margin="15,0" VerticalAlignment="Center"/>
                            <Button Content="CLEAR" HorizontalAlignment="Right" Click="ClearOutput_Click" FontSize="8" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="#444"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#007ACC"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DockPanel>
                    </Border>
                    <avalonEdit:TextEditor x:Name="DebugOutput" Background="#0A0A0A" Foreground="#D4D4D4" FontFamily="Consolas" FontSize="11" IsReadOnly="True" ShowLineNumbers="False" WordWrap="True" Padding="10" BorderThickness="0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>