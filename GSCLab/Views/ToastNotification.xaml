<Window x:Class="GSCLab.Views.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToastNotification" Height="65" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual">

    <Border x:Name="NotificationToast" Background="#0C0C0C" BorderBrush="#222" BorderThickness="1" CornerRadius="8" Margin="10" Padding="15,10" Opacity="0">

        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="8" Opacity="0.6"/>
        </Border.Effect>

        <Border.RenderTransform>
            <TranslateTransform x:Name="ToastTransform" Y="20"/>
        </Border.RenderTransform>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock x:Name="NotificationIcon" Text="ℹ" Foreground="#007ACC" FontSize="14" FontWeight="Black" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Ellipse Width="8" Height="8" Fill="#007ACC" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock x:Name="NotificationMessage" Text="Message" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>