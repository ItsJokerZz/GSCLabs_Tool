<UserControl x:Class="GSCLab.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#050505" Foreground="White">

    <UserControl.Resources>
        <Style x:Key="ModernScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#007ACC" CornerRadius="3" Width="6" Margin="2,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="BorderBrush" Value="#151515"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="5" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#111"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="BorderBrush" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="border" Property="Background" Value="#151515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="140"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="0,0,16,16" BorderBrush="#111" BorderThickness="0,0,0,1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#090909" Offset="0.0"/>
                            <GradientStop Color="#001833" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Grid.Row="0" Grid.RowSpan="2" Margin="40,80,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="110" Height="110" CornerRadius="55" Background="#0C0C0C" BorderBrush="#050505" BorderThickness="6" VerticalAlignment="Bottom">
                        <Border BorderBrush="#007ACC" BorderThickness="1" CornerRadius="55">
                            <Grid>
                                <TextBlock Text="👤" FontSize="45" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#444"/>
                                <Border CornerRadius="55">
                                    <Border.Background>
                                        <ImageBrush x:Name="ImgProfileMain" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <Border Width="20" Height="20" Background="#050505" CornerRadius="10" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,4,4" BorderThickness="0">
                                    <Ellipse Fill="#28A745" Margin="4"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="20,0,0,15">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                            <TextBlock x:Name="TxtUsername" Text="Username" FontSize="28" FontWeight="Black" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Border Background="#121820" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" MaxWidth="300">
                                <TextBlock x:Name="TxtUserStatus" Text="GSCLabs On Top" Foreground="#007ACC" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Unknown" Foreground="#007ACC" FontSize="12" FontWeight="Bold" Margin="0,0,15,0" Name="RoleLabel"/>
                            <TextBlock Text="•" Foreground="#444" FontSize="12" Margin="0,0,15,0"/>
                            <TextBlock x:Name="TxtDevLevel" Text="Level 2 Modder" Foreground="#888" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,15">
                        <Button Content="⚙ Edit Settings" Style="{StaticResource ActionBtn}" Click="OpenSettingsWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="40,20,40,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <UniformGrid Columns="3" Margin="0,0,0,20">
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL INJECTIONS" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtTotalInjections" Text="0" FontSize="32" FontWeight="Black"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="LIBRARY PROJECTS" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtLibraryCount" Text="0" FontSize="32" FontWeight="Black"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource GlassCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="SUPPORT TICKETS" Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="0" FontSize="32" FontWeight="Black" Foreground="#FFC107"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="MY MARKETPLACE PROJECTS" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource GlassCard}" MinHeight="140">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="MyProjectsList" Orientation="Horizontal">
                                <TextBlock Text="No projects uploaded yet." Foreground="#444" VerticalAlignment="Center" HorizontalAlignment="Center" FontStyle="Italic"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="INJECTIONS BY GAME" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource GlassCard}">
                        <WrapPanel x:Name="GameInjectionsList" Orientation="Horizontal"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="RANK PROGRESS" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                <TextBlock Text="Current XP" Foreground="#888" FontSize="12" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TxtDevXP" Text="450 / 500" Foreground="#007ACC" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <Border x:Name="DevProgressBg" Background="#050505" Height="8" CornerRadius="4" BorderBrush="#151515" BorderThickness="1" Margin="0,0,0,15">
                                <Border x:Name="DevProgressFill" Background="#007ACC" HorizontalAlignment="Left" Width="180" CornerRadius="3">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#007ACC" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                    </Border.Effect>
                                </Border>
                            </Border>
                            <TextBlock x:Name="TxtNextRank" Text="Next Rank: Verified Modder" Foreground="#555" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="RECENT ACTIVITY" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource GlassCard}" MinHeight="200">
                        <StackPanel x:Name="ActivityLogList">
                            <DockPanel Margin="0,0,0,15">
                                <Border Width="30" Height="30" CornerRadius="15" Background="#050505" BorderBrush="#222" BorderThickness="1" Margin="0,0,12,0">
                                    <TextBlock Text="🚀" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Injected 'ZombieLand' into BO2" FontSize="12" Foreground="#DDD" Margin="0,0,0,2"/>
                                    <TextBlock Text="2 hours ago" Foreground="#555" FontSize="10"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="CONNECTED ACCOUNTS" Foreground="#666" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Border Style="{StaticResource GlassCard}">
                        <StackPanel>

                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/github_logo.png" Width="25" Height="25" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="GitHub" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtGithubStatus" Text="Not Linked" Foreground="#FF4444" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <DockPanel Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/discord_logo.png" Width="25" Height="25" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Discord" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtDiscordStatus" Text="Not Linked" Foreground="#FF4444" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>

                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>