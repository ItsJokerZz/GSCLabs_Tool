<UserControl x:Class="GSCLab.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#030303" Foreground="White">

    <UserControl.Resources>

        <Style x:Key="ModernScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#262626" CornerRadius="3" Width="5" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect Color="#007ACC" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/>
                            </Border.Effect>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#008BE6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="BorderBrush" Value="#222222"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="border" Property="Background" Value="#121212"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconGameTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#080808"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="accent" Width="3" HorizontalAlignment="Left" Background="Transparent" CornerRadius="2" Margin="-10,12,0,12"/>

                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#1C1C1C" BorderThickness="1" ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>
                                <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                       Stretch="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.4" x:Name="img"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#383838"/>
                                <Setter TargetName="border" Property="Background" Value="#121212"/>
                                <Setter TargetName="img" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="border" Property="Background" Value="#0D1926"/>
                                <Setter TargetName="accent" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="img" Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SleekSearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#080808"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#1E1E1E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" x:Name="border">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="border" Property="Background" Value="#0C0C0C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="MainContentGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#060606" BorderBrush="#161616" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Style="{StaticResource OutlineActionBtn}" Width="48" Height="48" Name="HomeNavBtn" Click="HomeNavBtn_Click" ToolTip="Marketplace Home" Margin="0,20,0,10" HorizontalAlignment="Center" Padding="0">
                    <TextBlock Text="🏠" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <Border Grid.Row="1" Height="1" Background="#161616" Margin="12,0,12,5"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding NavCategories}" Margin="0,5">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Height="1" Background="#161616" Margin="12,4,12,12" Visibility="{Binding SeparatorVisibility}"/>
                                    <RadioButton Tag="{Binding LogoPath}" Content="{Binding ImageStretch}" ToolTip="{Binding Title}" Style="{StaticResource IconGameTabStyle}" GroupName="LibraryNavGroup" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="Category_Checked" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="3" Style="{StaticResource OutlineActionBtn}" Width="48" Height="48" Name="ShowUploadMenuBtn" Click="ShowUploadMenuBtn_Click" ToolTip="Publish New Menu" Margin="0,10,0,20" HorizontalAlignment="Center" Padding="0">
                    <TextBlock Text="☁️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#030303">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#161616" BorderThickness="0,0,0,1" Background="#040404">
                <DockPanel LastChildFill="False" Margin="25,0">
                    <TextBlock x:Name="ViewTitle" Text="Community Menus" VerticalAlignment="Center" Foreground="White" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left"/>

                    <TextBox x:Name="SearchInput" DockPanel.Dock="Right" Style="{StaticResource SleekSearchBox}" Width="260" Height="36" Margin="0,0,15,0" Text="Search menus..." GotFocus="SearchInput_GotFocus" LostFocus="SearchInput_LostFocus" TextChanged="SearchInput_TextChanged"/>

                    <Border DockPanel.Dock="Right" Background="#0A0A0A" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center" Padding="14,7" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Role:" Foreground="#666" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UserRoleText" Text="GSC Developer" Foreground="#007ACC" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" x:Name="BrowseView" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="HomeSectionsContainer" Margin="25">

                    <WrapPanel x:Name="ScriptsContainer" Visibility="Collapsed"/>

                    <StackPanel x:Name="StorefrontHomeFeed">

                        <Border Background="#0B0B0B" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="10" Padding="25" Margin="0,0,0,25" ClipToBounds="True">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Welcome to the GSCLab Marketplace" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Discover, share, and inject top-tier community GSC menus across multiple game engines. Want to publish your own custom menu projects? Verified GSC Developers can upload and manage items directly using the GSC publishing tool!" Foreground="#999" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#121F2B" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="5" Padding="10,4">
                                            <TextBlock Text="💡Tip. Show Your Work In The GSCLabs Server Might Get GSC Developer Role" Foreground="#007ACC" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="🔥 Most Recent Uploads" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,25">
                            <WrapPanel x:Name="RecentContainer" Orientation="Horizontal"/>
                        </ScrollViewer>

                        <TextBlock Text="🎁 Free Community Menus" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,25">
                            <WrapPanel x:Name="FreeContainer" Orientation="Horizontal"/>
                        </ScrollViewer>

                        <TextBlock Text="⚡ Most Injected" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,25">
                            <WrapPanel x:Name="InjectedContainer" Orientation="Horizontal"/>
                        </ScrollViewer>

                        <TextBlock Text="💎 Premium &amp; Paid Menus" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,25">
                            <WrapPanel x:Name="PaidContainer" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>