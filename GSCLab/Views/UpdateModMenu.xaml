<Window x:Class="GSCLab.Views.UpdateModMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="450" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="25,8"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" x:Name="border" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0098FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#222"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="25,8"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" x:Name="border" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Border Background="#0C0C0C" BorderBrush="#222" BorderThickness="1" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="8" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#111" CornerRadius="8,8,0,0" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="15,12">
                    <DockPanel>
                        <Ellipse Width="8" Height="8" Fill="#007ACC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="UPDATE PROJECT" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="25">

                    <Border Background="#161616" CornerRadius="4" Padding="12" Margin="0,0,0,20" BorderBrush="#222" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TARGETING PROJECT" Foreground="Gray" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtMenuName" Text="Loading..." Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,15,0"/>
                                <Border Background="#007ACC" CornerRadius="3" Padding="6,2">
                                    <TextBlock x:Name="TxtGameName" Text="Loading..." Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="VERSION" Foreground="Gray" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtVersion" Background="#161616" Foreground="White" BorderBrush="#222" Margin="0,0,0,15" Padding="8"/>

                    <TextBlock Text="CHANGELOG" Foreground="Gray" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtChangelog" Height="80" Background="#161616" Foreground="White" BorderBrush="#222" Margin="0,0,0,15" Padding="8" AcceptsReturn="True"/>

                    <TextBlock Text="PROJECT FOLDER" Foreground="Gray" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Button x:Name="BtnSelectFolder" Content="SELECT FOLDER..." Click="SelectFolder_Click" Background="#161616" Foreground="#DDD" BorderBrush="#222" Padding="8" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryActionBtn}"/>
                    <TextBlock x:Name="TxtFolderPath" Text="No folder selected" FontSize="10" Foreground="#555" Margin="0,5,0,0" FontStyle="Italic"/>
                </StackPanel>

                <Border Grid.Row="2" Background="#111" CornerRadius="0,0,8,8" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0" Padding="15,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="CANCEL" Click="Close_Click" Style="{StaticResource SecondaryActionBtn}"/>
                        <Button Content="PUSH UPDATE" Click="PushUpdate_Click" Style="{StaticResource PrimaryActionBtn}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>