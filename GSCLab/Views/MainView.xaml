<Window x:Class="GSCLab.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GSCLab - GSC Toolset" Height="650" Width="1100"
        WindowStyle="None" AllowsTransparency="True" Background="#121212"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NavImageButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Margin="5,2">
                            <Image Width="24" Height="24" Stretch="Uniform" Opacity="0.5" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="border" Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#202020" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#0F0F0F" Grid.Column="0" BorderBrush="#202020" BorderThickness="0,0,1,0">
                <Grid Margin="5,25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,35" HorizontalAlignment="Center">
                        <TextBlock Text="GSC" Foreground="#007ACC" FontSize="16" FontWeight="Black" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton Style="{StaticResource NavImageButtonStyle}" IsChecked="True" Tag="pack://application:,,,/Assets/home.png" Command="{Binding NavCommand}" CommandParameter="Home"/>
                        <RadioButton Style="{StaticResource NavImageButtonStyle}" Tag="pack://application:,,,/Assets/compiler.png" Command="{Binding NavCommand}" CommandParameter="Compiler"/>
                        <RadioButton Style="{StaticResource NavImageButtonStyle}" Tag="pack://application:,,,/Assets/library.png" Command="{Binding NavCommand}" CommandParameter="Library"/>
                        <RadioButton Style="{StaticResource NavImageButtonStyle}" Tag="pack://application:,,,/Assets/account.png" Command="{Binding NavCommand}" CommandParameter="Account"/>
                        <RadioButton Style="{StaticResource NavImageButtonStyle}" Tag="pack://application:,,,/Assets/chat.png" Command="{Binding NavCommand}" CommandParameter="Chat"/>
                        <RadioButton Style="{StaticResource NavImageButtonStyle}" Tag="pack://application:,,,/Assets/settings.png" Command="{Binding NavCommand}" CommandParameter="Settings"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                        <Button Background="Transparent" BorderThickness="0" Margin="0,0,0,15" Cursor="Hand" Name="Github_Button" Click="Github_Button_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Button.Template>

                            <Image Source="pack://application:,,,/Assets/github_logo.png" Width="24" Height="24" Opacity="0.6"/>
                        </Button>

                        <Button Command="{Binding LogoutCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="⏻" Foreground="#CC3333" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border Background="Transparent" MouseLeftButtonDown="Border_MouseLeftButtonDown"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0">
                        <Button Content="0" Style="{StaticResource WindowControlStyle}" Click="MinBtn_Click" FontFamily="Marlett"/>
                        <Button Content="1" Style="{StaticResource WindowControlStyle}" Click="MaxBtn_Click" FontFamily="Marlett" x:Name="MaxBtn"/>
                        <Button Content="r" Style="{StaticResource WindowControlStyle}" Click="CloseBtn_Click" FontFamily="Marlett" Tag="Close"/>
                    </StackPanel>
                </Grid>

                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="5"/>
            </Grid>
        </Grid>
    </Border>
</Window>