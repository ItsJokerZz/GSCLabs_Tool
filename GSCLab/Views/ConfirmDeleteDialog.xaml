<Window x:Class="GSCLab.Views.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Delete" 
        Width="450" 
        SizeToContent="Height"
        MinWidth="450"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterOwner" 
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="25,8"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" x:Name="border" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0098FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#222"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="25,8"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" x:Name="border" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Border Background="#0C0C0C" BorderBrush="#222" BorderThickness="1" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="8" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#111" CornerRadius="8,8,0,0" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="15,12">
                    <DockPanel>
                        <Ellipse Width="8" Height="8" Fill="#CC3333" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="CONFIRM DELETE" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" Margin="25,30,25,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🗑️" FontSize="28" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="#0098FF"/>
                    <TextBlock x:Name="MessageBlock" Grid.Column="1" Text="Are you sure you want to delete this item? This action cannot be undone." 
                               Foreground="#D4D4D4" FontSize="13" TextWrapping="Wrap" LineHeight="20" VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="2" Background="#111" CornerRadius="0,0,8,8" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0" Padding="15,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="KEEP" Style="{StaticResource SecondaryActionBtn}" Click="Cancel_Click"/>
                        <Button Content="DELETE" Style="{StaticResource PrimaryActionBtn}" Click="Confirm_Click" Background="#CC3333"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>